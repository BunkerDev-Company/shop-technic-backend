{
  "name": "shop-technic-backend",
  "version": "0.0.1",
  "description": "Shop technic backend (учебный: миграции + Prisma)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "db:init": "tsx scripts/db-init.ts",
    "migrate:up": "node-pg-migrate --migrations-dir migrations --ts-node up",
    "migrate:down": "node-pg-migrate --migrations-dir migrations --ts-node down",
    "migrate:create": "node-pg-migrate --migrations-dir migrations --ts-node create",
    "migrate:status": "node-pg-migrate --migrations-dir migrations --ts-node status",
    "migrate:reset": "node-pg-migrate --migrations-dir migrations --ts-node reset",
    "prisma:pull": "prisma db pull && prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "dotenv": "^17.3.1",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.20.0",
    "prisma": "^7.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.18.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  }
}
